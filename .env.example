# Environment variables

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
MONGODB_URI=mongodb://127.0.0.1:27017/bakery-platform
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOG_LEVEL=info
REQUIRE_DATABASE_CONNECTION=false

OTP_HASH_SECRET=change-this-development-secret-to-a-random-32-character-value

JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES=
REFRESH_TOKEN_EXPIRES=

OTP_PROVIDER=
OTP_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

UPI_ID=
GOOGLE_MAP_API_KEY=

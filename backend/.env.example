# ==========================================
# THE ONLINE BAKERY PLATFORM - PRODUCTION ENV
# ==========================================

# Server Configuration
PORT=4000
NODE_ENV=production
APP_NAME=The Online Bakery
CLIENT_URL=https://theonlinebakery.in

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
REQUIRE_DATABASE_CONNECTION=true
REQUIRE_MONGODB_TRANSACTIONS=true
API_PREFIX=/api/v1
CORS_ORIGINS=https://theonlinebakery.in
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# JWT Authentication
JWT_SECRET=<generate-a-distinct-random-32-plus-character-secret>
JWT_REFRESH_SECRET=<generate-a-distinct-random-32-plus-character-secret>
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=30d

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_CALLBACK_URL=https://theonlinebakery.in/api/v1/auth/google/callback

# To bootstrap the first admin, first sign in with Google as that user, then run:
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com npm run db:bootstrap-admin



# Razorpay Payment Gateway
RAZORPAY_KEY_ID=<razorpay-key-id>
RAZORPAY_KEY_SECRET=<razorpay-key-secret>
RAZORPAY_WEBHOOK_SECRET=<razorpay-webhook-secret>

# Email API (Resend)
RESEND_API_KEY=<resend-api-key>
RESEND_FROM_EMAIL=orders@theonlinebakery.in
SENDER_EMAIL=orders@theonlinebakery.in

# WhatsApp API
WHATSAPP_API_TOKEN=<whatsapp-business-api-token>
WHATSAPP_PHONE_NUMBER_ID=<whatsapp-phone-number-id>
WHATSAPP_API_VERSION=v20.0
WHATSAPP_DEFAULT_TEMPLATE=hello_world
WHATSAPP_DEFAULT_LANGUAGE=en_US

# Cloudinary Asset Storage
CLOUDINARY_NAME=<cloudinary-cloud-name>
CLOUDINARY_KEY=<cloudinary-api-key>
CLOUDINARY_SECRET=<cloudinary-api-secret>

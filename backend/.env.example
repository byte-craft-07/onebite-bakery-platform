# ==========================================
# ONEBITE BAKERY PLATFORM - PRODUCTION ENV
# ==========================================

# Server Configuration
PORT=4000
NODE_ENV=production
APP_NAME=OneBite Bakery
CLIENT_URL=https://onebitebakery.in

# Database
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/onebite_bakery?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_onebite_2026_bakery
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_onebite_2026_bakery
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Resend / Brevo Email API
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=orders@onebitebakery.in
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key
SENDER_EMAIL=orders@onebitebakery.in

# WhatsApp & SMS Notifications
WHATSAPP_API_TOKEN=your_whatsapp_business_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_API_VERSION=v20.0
WHATSAPP_DEFAULT_TEMPLATE=hello_world
WHATSAPP_DEFAULT_LANGUAGE=en_US
MSG91_API_KEY=your_msg91_sms_api_key
MSG91_SENDER_ID=ONEBTE

# Cloudinary Asset Storage
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET=your_cloudinary_api_secret
